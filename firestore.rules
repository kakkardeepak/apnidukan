rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'madaag1@admin.apnidukan.com';
    }

    // Storefront data is public-readable; only the admin may write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    // Each customer can create their own profile doc (uid must match doc id)
    // and read/update/delete only their own profile. Passwords are never stored here.
    match /customers/{customerId} {
      allow create: if signedIn() && request.auth.uid == customerId
                    && !('password' in request.resource.data);
      allow read, update, delete: if signedIn() && request.auth.uid == customerId;
    }

    // Deny everything else — including legacy config/adminCredentials.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
